{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeriScript",
  "version": "0.1.0",
  "identifier": "live.veriscript.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline OCR for Nepali, Hindi and English documents",
    "longDescription": "VeriScript turns photos, scans and PDFs into cleaned pages, searchable PDFs, transcripts and Markdown on your own computer, and puts every uncertain number in a review queue instead of guessing.",
    "copyright": "MIT licensed",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
